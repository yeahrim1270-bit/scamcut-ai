# Anthropic API 키 (https://console.anthropic.com) - 서버에서만 사용되며 브라우저로 노출되지 않습니다.
ANTHROPIC_API_KEY=
# 선택: 모델 / 추론 노력 수준 (low | medium | high)
ANTHROPIC_MODEL=claude-opus-5-5
SCAMCUT_EFFORT=low

# OpenAI (서버에서만 사용 — NEXT_PUBLIC_ 접두사를 붙이지 마세요). Vercel 에서는 Environment Variables 에 등록하세요.
OPENAI_API_KEY=
# 사용할 모델. 프로젝트에서 접근 가능한 모델이어야 합니다(기본 gpt-5-mini).
OPENAI_MODEL=gpt-5-mini
